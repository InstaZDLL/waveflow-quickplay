[Desktop Entry]
Type=Application
Name={{name}}
Comment=Play audio files quickly
Comment[fr]=Lire rapidement des fichiers audio
Comment[de]=Audiodateien schnell wiedergeben
Comment[es]=Reproduce archivos de audio al instante
Comment[it]=Riproduci rapidamente i file audio
Comment[zh_CN]=快速播放音频文件
Comment[ja]=オーディオファイルをすばやく再生
Comment[ko]=오디오 파일을 빠르게 재생합니다
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
Categories={{categories}}
MimeType=audio/flac;audio/mpeg;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/ogg;audio/vorbis;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/wav;audio/x-wav;audio/vnd.wave;audio/aiff;audio/x-aiff;audio/x-dsf;audio/x-dff;audio/x-dsd;audio/x-mpegurl;audio/mpegurl;application/vnd.apple.mpegurl;
StartupWMClass=app.waveflow.quickplay
Actions=Enqueue;

[Desktop Action Enqueue]
Name=Add to QuickPlay playlist
Name[fr]=Ajouter à la liste de lecture de QuickPlay
Name[de]=Zur QuickPlay-Wiedergabeliste hinzufügen
Name[es]=Añadir a la lista de QuickPlay
Name[it]=Aggiungi alla playlist di QuickPlay
Name[zh_CN]=添加到 QuickPlay 播放列表
Name[ja]=QuickPlay のプレイリストに追加
Name[ko]=QuickPlay 재생목록에 추가
Exec={{exec}} --enqueue %F
