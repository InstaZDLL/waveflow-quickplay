[Desktop Entry]
Type=Application
Name={{name}}
Comment=Play audio files quickly
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
Categories={{categories}}
MimeType=audio/flac;audio/mpeg;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/ogg;audio/vorbis;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/wav;audio/x-wav;audio/vnd.wave;audio/aiff;audio/x-aiff;audio/x-dsf;audio/x-dff;audio/x-dsd;
StartupWMClass=app.waveflow.quickplay
Actions=Enqueue;

[Desktop Action Enqueue]
Name=Add to WaveFlow QuickPlay playlist
Exec={{exec}} --enqueue %F
